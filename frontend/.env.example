# Set after deploying the Render API (e.g. https://railyatra-api.onrender.com)
VITE_API_URL=

# Google Sign-In (same OAuth 2.0 Web client ID as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Web3Forms — contact form fallback (same key as backend WEB3FORMS_ACCESS_KEY)
VITE_WEB3FORMS_ACCESS_KEY=
VITE_WEB3FORMS_FROM_NAME=RailYatra
