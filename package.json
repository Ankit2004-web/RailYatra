{
  "name": "railyatra",
  "version": "2.0.0",
  "description": "RailYatra — Indian railway reservation system with React + SQL Server",
  "private": true,
  "engines": {
    "node": ">=20 <=22"
  },
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "client:dev": "npm run frontend:dev",
    "client:build": "npm run frontend:build",
    "db:sync": "npm run db:sync --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:setup": "npm run db:setup --prefix backend",
    "db:migrate-master": "npm run db:migrate-master --prefix backend",
    "db:backfill-running-days": "npm run db:backfill-running-days --prefix backend",
    "db:backfill-coach-capacity": "npm run db:backfill-coach-capacity --prefix backend",
    "db:backfill-2s": "npm run db:backfill-2s --prefix backend",
    "db:seed-coach-rules": "npm run db:seed-coach-rules --prefix backend",
    "import:coach-composition": "npm run import:coach-composition --prefix backend",
    "import:railway": "npm run import:railway --prefix backend",
    "import:datameet": "npm run import:datameet --prefix backend",
    "download:railway": "npm run download:railway --prefix backend",
    "fix:driver": "npm run fix:driver --prefix backend",
    "dotnet:build": "dotnet build backend/dotnet/RailYatra.sln",
    "dotnet:test": "dotnet test backend/dotnet/RailYatra.sln",
    "dotnet:api": "dotnet run --project backend/dotnet/RailYatra.Api",
    "import:dotnet": "curl -X POST http://localhost:5080/api/import/full",
    "dev": "npm run dev --prefix backend",
    "start": "node backend/scripts/start.js",
    "test": "npm run test --prefix backend"
  }
}
