DB_SERVER=(localdb)\MSSQLLocalDB
DB_NAME=RailwayReservation
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=true

# Cloud / Render only — uncomment and set for Azure SQL:
# DB_DRIVER=tedious
# DB_TRUSTED_CONNECTION=false
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERT=false
# DB_SERVER=your-server.database.windows.net

JWT_SECRET=your_jwt_secret_here
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Logging
LOG_LEVEL=info

# Rate limits (requests per window)
RATE_LIMIT_API=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_BOOKING=30

# Razorpay (optional - dev mode works without keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email — use SMTP and/or Web3Forms (https://web3forms.com)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web3Forms access key (free — contact form, password reset, booking emails without SMTP)
# Create key at https://web3forms.com — emails go to the inbox you verify there.
# For password-reset / booking emails TO users, enable Web3Forms Pro Autoresponder in dashboard.
WEB3FORMS_ACCESS_KEY=
WEB3FORMS_FROM_NAME=RailYatra

# Live train (NTES — Indian Railways National Train Enquiry System)
NTES_CACHE_TTL_MS=120000

# Support chat AI (free tiers — add at least one key for real AI replies)
# Groq: https://console.groq.com/keys  |  Gemini: https://aistudio.google.com/apikey
AI_CHAT_PROVIDER=auto
AI_CHAT_TIMEOUT_MS=25000
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
