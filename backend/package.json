{
    "name": "railway-reservation-backend",
    "version": "1.0.0",
    "description": "RailYatra API with SQL Server",
    "main": "server.js",
    "scripts": {
        "start": "node scripts/start.js",
        "dev": "nodemon server.js",
        "db:sync": "node scripts/run.js ../database/sync.js",
        "db:seed": "node scripts/run.js ../database/seed.js",
        "db:setup": "node scripts/run.js ../database/sync.js && node scripts/run.js ../database/seed.js",
        "db:migrate-master": "node scripts/run.js ../database/migrate-master-data.js",
        "db:backfill-running-days": "node scripts/run.js ../database/backfill-running-days.js",
        "db:backfill-coach-capacity": "node scripts/run.js ../database/backfill-coach-capacity.js",
        "db:backfill-2s": "node scripts/run.js ../database/backfill-train-class-2s.js",
        "db:seed-coach-rules": "node scripts/run.js ../database/seed-coach-rules.js",
        "import:coach-composition": "node scripts/run.js ../database/import/CoachCompositionImporter.js",
        "import:railway": "node scripts/run.js ../database/import/run-import.js",
        "import:datameet": "node scripts/run.js ../database/import/run-datameet-import.js",
        "download:railway": "powershell -ExecutionPolicy Bypass -File scripts/download-railway-data.ps1 -Target datameet",
        "fix:driver": "npm install msnodesqlv8",
        "test": "node --test tests/*.test.js"
    },
    "engines": {
        "node": ">=20 <=22"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^11.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.18.2",
        "express-rate-limit": "^7.5.0",
        "express-validator": "^7.2.1",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "mssql": "^11.0.1",
        "nodemailer": "^6.10.0",
        "odbc": "^2.5.0",
        "otplib": "^13.4.1",
        "pdfkit": "^0.16.0",
        "qrcode": "^1.5.4",
        "razorpay": "^2.9.8",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "nodemon": "^3.0.1",
        "supertest": "^7.0.0"
    },
    "optionalDependencies": {
        "msnodesqlv8": "^4.5.0"
    },
    "overrides": {
        "jwa": "^2.0.0"
    }
}
