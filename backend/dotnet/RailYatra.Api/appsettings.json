{
  "Urls": "http://localhost:5080",
  "ConnectionStrings": {
    "RailwayDb": "Server=(localdb)\\MSSQLLocalDB;Database=RailwayReservation;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "RailwayImport": {
    "RawDataDirectory": "../../../database/data/railway/raw",
    "PrimarySource": "DataMeet",
    "DeactivateMissingTrains": true,
    "RouteBatchSize": 500,
    "EnableScheduledImport": false,
    "ScheduleCron": "0 2 * * 0",
    "DataMeet": {
      "Name": "DataMeet Indian Railways JSON (CC0)",
      "BaseUrl": "https://raw.githubusercontent.com/datameet/railways/master",
      "StationsFile": "stations/stations.json",
      "TrainsFile": "trains/trains.json",
      "SchedulesFile": "schedules/schedules.json",
      "Publisher": "DataMeet Community",
      "LicenseNotes": "CC0 — NOT official Ministry of Railways current timetable. Potentially outdated (~2016).",
      "DatasetVersion": "2016-08"
    },
    "Ogd": {
      "Enabled": false,
      "CatalogUrl": "https://www.data.gov.in/catalog/indian-railways-train-time-table"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
